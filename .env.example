# Railway MySQL service provides these automatically when linked
# MYSQLHOST=mysql
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=auto-generated
# MYSQLDATABASE=opencart

# Store URL (set automatically by Railway via RAILWAY_PUBLIC_DOMAIN)
# HTTP_SERVER=https://your-app.up.railway.app

# Admin credentials (change after first login!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_EMAIL=admin@example.com

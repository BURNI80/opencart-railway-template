# ============================================================
# OpenCart — Railway Template
# Todas las variables son OPCIONALES (tienen un defecto sensato).
# La template se despliega sin configurar nada.
# ============================================================

# --- Credenciales del panel admin (¡cámbialas tras el primer login!) ---
# Usuario del panel de administración
ADMIN_USERNAME=admin
# Contraseña del panel de administración
ADMIN_PASSWORD=opencart
# Email del administrador
ADMIN_EMAIL=admin@example.com

# --- Base de datos ---
# Por defecto la template usa una MariaDB EMBEBIDA (sin configurar nada).
# Solo define MYSQLHOST si quieres usar una base de datos externa
# (por ejemplo mysql.railway.internal si tienes un servicio MySQL en Railway).
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLUSER=opencart
# MYSQLPASSWORD=opencart
# MYSQLDATABASE=opencart

# Prefijo de las tablas de la base de datos
# DB_PREFIX=oc_

# --- URL pública (opcional) ---
# Railway la detecta automáticamente desde RAILWAY_PUBLIC_DOMAIN.
# Solo envíala manualmente si necesitas forzarla (p.ej. dominio personalizado).
# HTTP_SERVER=https://tu-tienda.up.railway.app
